# syntax=docker/dockerfile:1
# Slim control-plane image: API + pipeline DB ops. Browser apply stays on the host.
FROM python:3.12-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    APPLYPILOT_DIR=/data \
    APPLY_MODE=off \
    APPLYPILOT_REQUIRE_TOKEN=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md ./
COPY src ./src
COPY scripts ./scripts
COPY config ./config

# Install runtime deps needed by the API/pipeline (skip Playwright/Chrome stack).
RUN pip install --no-cache-dir \
      "fastapi>=0.115" \
      "uvicorn[standard]>=0.30" \
      "pydantic>=2" \
      "typer>=0.9" \
      "rich>=13" \
      "httpx>=0.24" \
      "beautifulsoup4>=4.12" \
      "python-dotenv>=1.2.2" \
      "pyyaml>=6" \
      "pandas>=2" \
      "markdownify>=0.14" \
      "python-docx>=1.1" \
      "pypdf>=6.13.3" \
      "websocket-client>=1.0" \
    && pip install --no-cache-dir --no-deps -e .

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD curl -fsS http://127.0.0.1:8080/api/v1/health || exit 1

CMD ["uvicorn", "applypilot.api.app:app", "--host", "0.0.0.0", "--port", "8080"]
