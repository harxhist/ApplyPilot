# Copy to .env for docker compose / local serve. Never commit real secrets.

# Required in Docker (APPLYPILOT_REQUIRE_TOKEN=1)
APPLYPILOT_API_TOKEN=change-me-to-a-long-random-string

# Optional LLM / apply keys (pipeline stages in the API container)
CURSOR_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
CAPSOLVER_API_KEY=
LLM_PROVIDER=cursor
LLM_MODEL=default

# Data directory inside containers is /data (compose volume).
# On the host for CLI apply against the same DB, either:
#   export APPLYPILOT_DIR=~/.applypilot
# or mount/sync the compose volume contents.

APPLY_MODE=off
